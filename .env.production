# Production public configuration (mainnet). Committed on purpose: every value
# here is PUBLIC and ends up in the browser bundle. Vercel environment
# variables with the same names override these. Never add a secret here.

PUBLIC_SOLANA_NETWORK=mainnet-beta

# Cons router on mainnet, deployed 2026-10-02 (cons-programs deployments/mainnet-beta.json).
PUBLIC_CONS_PROGRAM_ID=H84c9kbVyPaT3EDa5mtfuUQiEVET2aCXJtnJeBwNPZhw

# Circle USDC and Tether USDT, classic SPL Token mints on Solana mainnet.
PUBLIC_CONS_ASSET_MINTS=USDC=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,USDT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# Routes the Cons operator delivers today; only these can be submitted.
# Add one when the operator serves it, e.g. token:USDC:arbitrum or message:base.
PUBLIC_CONS_LIVE_ROUTES=token:USDC:base
# Largest token amount per request (the treasury fronts each transfer).
PUBLIC_CONS_MAX_TOKEN_AMOUNT=1

# Browser facing RPC. api.mainnet-beta.solana.com answers 403 to browsers, so a
# CORS friendly public endpoint is the interim default. Replace with a
# dedicated RPC (Helius, Triton, QuickNode) via the Vercel variable of the same name.
PUBLIC_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
