# Production public configuration (mainnet). Committed on purpose: every value
# here is PUBLIC and ends up in the browser bundle. Vercel environment
# variables with the same names override these. Never add a secret here.

PUBLIC_SOLANA_NETWORK=mainnet-beta

# Cons router on mainnet, deployed 2026-10-02 (cons-programs deployments/mainnet-beta.json).
PUBLIC_CONS_PROGRAM_ID=H84c9kbVyPaT3EDa5mtfuUQiEVET2aCXJtnJeBwNPZhw

# Circle USDC and Tether USDT, classic SPL Token mints on Solana mainnet.
