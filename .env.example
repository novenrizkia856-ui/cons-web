# Cons public configuration.
# Every value here is PUBLIC and ends up in the browser bundle.
# Never put a private key, keypair, seed phrase or signing secret in this file.
# Leave a value empty to keep the matching UI in its "not configured" state.

# mainnet-beta | devnet | testnet
PUBLIC_SOLANA_NETWORK=mainnet-beta

# Cons Solana Program ID (base58). Empty until the program is deployed.
PUBLIC_CONS_PROGRAM_ID=

# Cons token mint address (base58). Empty shows "Coming Soon" on the landing page.
PUBLIC_CONS_TOKEN_MINT=

# Cons routing API, for example https://api.example.com. Empty uses the preview data layer.
PUBLIC_CONS_API_URL=

# Solana RPC endpoint. Empty falls back to the public cluster endpoint for PUBLIC_SOLANA_NETWORK.
PUBLIC_SOLANA_RPC_URL=

# Optional links. Empty hides the link.
PUBLIC_CONS_DOCS_URL=
PUBLIC_CONS_GITHUB_URL=
PUBLIC_SOLANA_EXPLORER_URL=https://explorer.solana.com
